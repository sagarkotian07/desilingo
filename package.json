    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vercel/config": "^0.7.0",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "jsdom": "^29.1.1",
