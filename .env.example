# Sarvam AI API key — https://dashboard.sarvam.ai
# Server-side only. NEVER prefix with NEXT_PUBLIC_: that inlines the key into the
# client bundle, where anyone can read it and spend your credits.
SARVAM_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxx

# Set to 1 to use the browser Web Speech API instead of Sarvam.
# Costs nothing — use this for day-to-day UI work.
MOCK_VOICE=0

# Kill switch. Set to 0 to make the Sarvam-backed routes refuse to spend credits.
SARVAM_ENABLED=1
